@implements IDisposable
<div class="form-group">
    <label for="search">@Label</label>
    <input
        type="text"
        class="form-control"
        value="@_userInput"
        @oninput="HandleInput" />
</div>

@if (_items.Any())
{
    <div class="search-result">
        <ul>
            @foreach (var item in _items)
            {
                <li
                    @key="item.Id"
                    @onclick="() => HandleItemSelect(item)">
                    @item.Name
                </li>
            }
        </ul>
    </div>
}
@code {
    private string _userInput = string.Empty;
    private List<ItemViewModel> _items = new();
    private CancellationTokenSource? _debounceTokenSource;

    [Parameter] public string Label { get; set; } = string.Empty;
    
    [Parameter] public TimeSpan DebounceTime { get; set; } = TimeSpan.FromMilliseconds(500);
    
    [Parameter] public Func<string, Task<IEnumerable<ItemViewModel>>>? SearchFunction { get; set; }
    
    [Parameter] public EventCallback<ItemViewModel> OnItemSelected { get; set; }

    private async Task HandleInput(ChangeEventArgs arg)
    {
        _userInput = arg.Value?.ToString() ?? string.Empty;
        
        // Cancel previous pending searches
        if (_debounceTokenSource is not null)
        {
            await _debounceTokenSource.CancelAsync();
        }
        _debounceTokenSource = new CancellationTokenSource();
        var token = _debounceTokenSource.Token;

        try
        {
            await Task.Delay(DebounceTime, token);
            if (string.IsNullOrWhiteSpace(_userInput) || SearchFunction is null)
            {
                _items.Clear();
                return;
            }
            
            var results = await SearchFunction.Invoke(_userInput);
            _items = results.ToList();
        }
        catch (OperationCanceledException)
        {
        }
    }
    
    private async Task HandleItemSelect(ItemViewModel item)
    {
        await OnItemSelected.InvokeAsync(item);
    }

    public void Dispose()
    {
        _debounceTokenSource?.Dispose();
    }
    
    public class ItemViewModel(int id, string name)
    {
        public int Id { get; set; } = id;
        public string Name { get; set; } = name;
    }
}