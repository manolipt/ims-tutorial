@page "/products/add"

@rendermode InteractiveServer

@inject ICommandHandler<AddEntryCommand<Product>> AddEntryCommandHandler
@inject NavigationManager Navigation

<h3>Add Product</h3>
<br/>

<EditForm Model="Product" OnValidSubmit="Save">
    <FluentValidationValidator/>
    <ValidationSummary/>

    <div class="form-group">
        <label for="name">
            Name
        </label>
        <InputText class="form-control" id="name" @bind-Value="Product!.ProductName"/>
        <ValidationMessage For="() => Product.ProductName"></ValidationMessage>
    </div>

    <div class="form-group">
        <label for="quantity">Quantity</label>
        <InputNumber class="form-control" id="quantity" @bind-Value="Product.Quantity"/>
        <ValidationMessage For="() => Product.Quantity"></ValidationMessage>
    </div>

    <div class="form-group">
        <label for="price">Price</label>
        <InputNumber class="form-control" id="price" @bind-Value="Product.Price"/>
        <ValidationMessage For="() => Product.Price"></ValidationMessage>
    </div>

    <div class="form-group">
        <label>Inventories</label>
        <ProductInventoriesComponent Product="Product"></ProductInventoriesComponent>
    </div>

    <br/>
    <button type="submit" class="btn btn-primary">Save</button>
    <a href="/products" class="btn btn-primary">Cancel</a>
</EditForm>

@code {
    private Product Product { get; init; } = new();

    private async Task Save()
    {
        await AddEntryCommandHandler.HandleAsync(new AddEntryCommand<Product>(Product));
        Navigation.NavigateTo("/products");
    }
}
