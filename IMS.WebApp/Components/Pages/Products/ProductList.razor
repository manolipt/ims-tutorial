@page "/products"

<h3>Product List</h3>
<br/>

<SearchComponent OnSearch="HandleSearch"></SearchComponent>

<ProductListComponent Filter="@_searchTerm"/>

<br/>

<a href="/products/add" class="btn btn-primary">
    Add Product
</a>

@code
{
    private string _searchTerm = string.Empty;

    private void HandleSearch(string searchFilter)
    {
        _searchTerm = searchFilter;
    }
}
