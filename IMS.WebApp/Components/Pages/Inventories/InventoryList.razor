@page "/inventories"

<h3>Inventory List</h3>
<br/>

<SearchComponent OnSearch="HandleSearch"></SearchComponent>

<InventoryListComponent Filter="@_searchTerm"/>

<br/>

<a href="/inventories/add" class="btn btn-primary">
    Add Inventory
</a>

@code
{
    private string _searchTerm = string.Empty;

    private void HandleSearch(string searchFilter)
    {
        _searchTerm = searchFilter;
    }
}
