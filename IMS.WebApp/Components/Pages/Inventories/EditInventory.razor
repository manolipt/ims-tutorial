@page "/inventories/edit/{InventoryId:int}"

@inject ICommandHandler<EditInventoryCommand> EditInventoryCommandHandler
@inject IQueryHandler<GetInventoryByIdQuery, Inventory?> GetInventoryByIdQueryHandler
@inject NavigationManager Navigation

<h3>Edit Inventory</h3>

@if (Inventory is not null)
{
    <EditForm Model="Inventory" FormName="Inventory" OnValidSubmit="Save">
        <FluentValidationValidator/>
        <ValidationSummary/>

        <InputNumber @bind-Value="Inventory.InventoryId" hidden></InputNumber>

        <div class="form-group">
            <label for="name">Inventory Name</label>
            <InputText class="form-control" id="name" @bind-Value="Inventory.InventoryName"/>
            <ValidationMessage For="() => Inventory.InventoryName"></ValidationMessage>
        </div>

        <div class="form-group">
            <label for="quantity">Quantity</label>
            <InputNumber class="form-control" id="quantity" @bind-Value="Inventory.Quantity"/>
            <ValidationMessage For="() => Inventory.Quantity"></ValidationMessage>
        </div>

        <div class="form-group">
            <label for="price">Price</label>
            <InputNumber class="form-control" id="price" @bind-Value="Inventory.Price"/>
            <ValidationMessage For="() => Inventory.Price"></ValidationMessage>
        </div>

        <br/>
        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/inventories" class="btn btn-primary">Cancel</a>
    </EditForm>
}

@code {
    [Parameter] public int InventoryId { get; init; }

    [SupplyParameterFromForm] private Inventory? Inventory { get; set; }

    private async Task Save()
    {
        if (Inventory is null) return;
        await EditInventoryCommandHandler.HandleAsync(new EditInventoryCommand(Inventory));
        Navigation.NavigateTo("/inventories");
    }

    protected override async Task OnParametersSetAsync()
    {
        Inventory ??= await GetInventoryByIdQueryHandler
            .HandleAsync(new GetInventoryByIdQuery(InventoryId));

        if (Inventory is null)
        {
            Navigation.NotFound();
        }
    }

}
